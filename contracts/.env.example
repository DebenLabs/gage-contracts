# Copy to .env and never commit the copy. contracts/.env is gitignored.
ROBINHOOD_RPC_URL=
ROBINHOOD_RPC_FALLBACK_URL=
# Testnet (chain id 46630), public endpoint: https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=
# Pinned block for mainnet fork tests (0 = latest)
FORK_BLOCK=0

# Mainnet deploy parameters (Deploy.s.sol)
GAGE_FEE_BPS=50
GAGE_GRACE=172800
GAGE_SALT=gage.v1

# Testnet run (DeployTestnet.s.sol, E2E.s.sol, test/fork/TestnetDeployment.fork.t.sol). Testnet-only keys.
TESTNET_DEPLOYER_KEY=
BORROWER_KEY=
LENDER_KEY=
GAGE_TESTNET_SALT=gage.testnet.v1
ACTOR_GAS_WEI=20000000000000000
DEPLOYMENT_TAG=
GAGE_DEPLOYMENT=deployments/46630.json
GAGE_E2E_RPC=

# Optional, token-layer scripts only.
# GAGE_ETH_LIQUIDITY scales the ETH/GAGE pool the token layer seeds (default 3e19, about 1 ETH + 1,000 GAGE);
# 15000000000000000000 is about 0.47 ETH, what the v4 testnet token layer used.
# GAGE_ETH_LIQUIDITY=15000000000000000000
# E2E_SKIP_COLLECT=true skips E2EToken's LP-collect step, which reverts NothingToCollect right after a redeploy.
# E2E_SKIP_COLLECT=true
